#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '\.(cpp|h|c|hpp)$')

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

NEEDS_FORMATTING=0

# Print one --lines=START:END argument per added or changed line range in a
# "git diff -U0" read from stdin. Same ranges as the CI check (check.yml).
changed_ranges() {
  awk '/^@@/ {
    split(substr($3, 2), r, ",")
    count = (r[2] == "") ? 1 : r[2]
    if (count > 0) print "--lines=" r[1] ":" (r[1] + count - 1)
  }'
}

# Run clang-format on the changed lines of each staged file
while IFS= read -r FILE; do
  echo Formatting "$FILE" ...
  # Format every line that differs from HEAD, as CI does against the PR base.
  # clang-format can cascade into adjacent lines; repeat with the new ranges
  # until the file stabilises, so CI's single pass then changes nothing.
  # In old tab-indented code each pass can re-indent one more line.
  MAX_ITER=100
  ITER=0
  while [ $ITER -lt $MAX_ITER ]; do
    PREV=$(cksum "$FILE")
    RANGES=$(git diff -U0 HEAD -- "$FILE" | changed_ranges)
    [ -n "$RANGES" ] && clang-format -i $RANGES "$FILE"
    [ "$(cksum "$FILE")" = "$PREV" ] && break
    ITER=$((ITER + 1))
  done
  [ $ITER -eq $MAX_ITER ] && echo "$FILE did not settle after $MAX_ITER passes; CI may still flag it"

  if ! git diff --quiet "$FILE"; then
    NEEDS_FORMATTING=1
    echo "$FILE"
  fi
done <<EOF
$STAGED_FILES
EOF

if [ $NEEDS_FORMATTING -eq 1 ]; then
  echo "The above files were auto-formatted. Please review and commit again."
  exit 1
fi

exit 0
